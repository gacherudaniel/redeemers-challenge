/**
 * @OnlyCurrentDoc
 *
 * Ruth 4 Game Night — Google Apps Script web app and shared back end.
 *
 * - doGet() serves the participant hub (Index.html) or, with ?page=admin, the admin
 *   dashboard (Admin.html). Admin data is only ever returned to verified administrators.
 * - api() is called by the pages through google.script.run when served from Apps Script.
 * - doPost() answers the GitHub Pages version (JSON sent as text/plain; see backend.js).
 *
 * This file holds the entry points and The Redeemer's Challenge leaderboard (unchanged
 * rules). Hub.gs holds the hub: configuration, live state, admin checks, arcade and puzzle
 * scores, and Team Showdown. Shared.gs and Content.gs are generated by `npm run build:gas`
 * from the same files the browser uses, so the server applies identical rules.
 *
 * Scores need this script to be bound to a Google Sheet (Extensions → Apps Script from
 * inside the Sheet). Without a Sheet the games still run, and scores stay on each device.
 */

// ───────────── Settings ─────────────

const LEADERBOARD_ENABLED = true; // set to false to switch the shared leaderboard off
const SHEET_NAME = 'Scores';
const HEADERS = ['Timestamp', 'Session', 'Nickname', 'Score', 'Correct', 'Total', 'Timer (s)', 'Answers', 'Device', 'Attempt'];
const LEADERBOARD_SIZE = 20;
const MAX_ENTRIES_PER_SESSION = 500;
const MAX_ATTEMPTS_PER_DEVICE = 5; // per session
const CACHE_SECONDS = 5;

// Scoring: keep in step with engine.js.
const POINTS_PER_CORRECT = 100;
const MAX_SPEED_BONUS = 50;
const MIN_HUMAN_MS = 250;
const TIMER_OPTIONS = [0, 10, 15, 20, 30];
const NAME_MAX = 20;

// ───────────── Entry points ─────────────

function doGet(e) {
  const params = (e && e.parameter) || {};
  if (params.action === 'ping' || params.action === 'leaderboard' || params.action === 'state') {
    return json_(handle_(params));
  }
  const admin = params.page === 'admin';
  const template = HtmlService.createTemplateFromFile(admin ? 'Admin' : 'Index');
  template.appUrl = serviceUrl_();
  template.session = normalizeSession_(params.session);
  template.mode = params.mode === 'group' || params.mode === 'individual' ? params.mode : '';
  template.game = HubDefaults.GAME_IDS.indexOf(params.game) >= 0 ? params.game : '';
  template.preview = params.preview === '1' ? '1' : '';
  let title = 'Ruth 4 Game Night';
  try { title = hubConfig_().session.title; } catch (err) { /* defaults until set up */ }
  return template
    .evaluate()
    .setTitle(admin ? 'Admin · ' + title : title)
    .addMetaTag('viewport', 'width=device-width, initial-scale=1, viewport-fit=cover');
}

function doPost(e) {
  let body;
  try {
    body = JSON.parse((e && e.postData && e.postData.contents) || '{}');
  } catch (err) {
    return json_(fail_('BAD_REQUEST', 'Invalid request.'));
  }
  return json_(handle_(body));
}

/** Called from the page with google.script.run.api({...}). */
function api(body) {
  return handle_(body || {});
}

/** Used by Index.html and Admin.html to pull in their styles and scripts. */
function include(name) {
  const allowed = ['Styles', 'AdminStyles', 'Client', 'AdminClient'];
  if (allowed.indexOf(name) < 0) throw new Error('Unknown include.');
  return HtmlService.createHtmlOutputFromFile(name).getContent();
}

/** Run once from the editor (choose "setup", then Run) to create the tabs and authorise. */
function setup() {
  const sheet = sheet_();
  if (!sheet) throw new Error('Open this script from a Google Sheet (Extensions → Apps Script) to use the shared leaderboards.');
  resultsSheet_();
  hubConfig_();
  hubLive_();
  const admins = adminEmails_();
  const msg = 'Ready: the "' + SHEET_NAME + '" and "' + RESULTS_SHEET + '" tabs are set up. Admins: ' + (admins.join(', ') || '(owner)') + '.';
  console.log(msg);
  return msg;
}

// ───────────── Request handling ─────────────

function handle_(body) {
  try {
    switch (body && body.action) {
      case 'ping':
        return ok_({ service: 'redeemers-challenge', leaderboard: !!sheetAvailable_(), hub: true });
      case 'submitScore':
        return submitScore_(body);
      case 'leaderboard':
        return leaderboard_(body);
      default:
        return hubHandle_(body); // Hub.gs
    }
  } catch (err) {
    console.error(err && err.stack ? err.stack : err);
    return fail_('SERVER_ERROR', 'Something went wrong on the server. Please try again.');
  }
}

function submitScore_(body) {
  if (!sheetAvailable_()) return fail_('NO_LEADERBOARD', 'The shared leaderboard is not set up.');

  const session = normalizeSession_(body.session);
  if (!session) return fail_('BAD_SESSION', 'Session codes are 3–16 letters or numbers.');
  const nickname = cleanName_(body.nickname);
  if (!nickname) return fail_('BAD_NAME', 'Please choose a nickname.');
  const device = token_(body.deviceId);
  const attempt = token_(body.attemptId);
  if (!device || !attempt) return fail_('BAD_REQUEST', 'Invalid request.');
  const timerSec = Number(body.timerSec);
  if (TIMER_OPTIONS.indexOf(timerSec) < 0) return fail_('BAD_REQUEST', 'Invalid timer setting.');

  const graded = grade_(body.answers, timerSec);
  if (!graded) return fail_('BAD_ANSWERS', 'Those answers could not be checked.');
  if (!hubAccepting_('redeemers-challenge')) return fail_('CLOSED', 'The Redeemer’s Challenge isn’t accepting scores right now.');
  const since = hubResetAt_('redeemers-challenge');

  const lock = LockService.getScriptLock();
  if (!lock.tryLock(10000)) return fail_('BUSY', 'The leaderboard is busy. Please try again.');
  let rows;
  let duplicate = false;
  try {
    const sheet = sheet_();
    rows = readRows_(sheet).filter(function (r) { return r.session === session && r.time > since; });
    const existing = rows.filter(function (r) { return r.attempt === attempt; })[0];
    if (existing) {
      duplicate = true;
      graded.score = existing.score;
      graded.correct = existing.correct;
    } else {
      if (rows.length >= MAX_ENTRIES_PER_SESSION) return fail_('SESSION_FULL', 'This session’s leaderboard is full.');
      const fromDevice = rows.filter(function (r) { return r.device === device; }).length;
      if (fromDevice >= MAX_ATTEMPTS_PER_DEVICE) return fail_('TOO_MANY_ATTEMPTS', 'You have reached the limit of ' + MAX_ATTEMPTS_PER_DEVICE + ' plays for this session.');
      const row = {
        timestamp: new Date(),
        session: session,
        nickname: nickname,
        score: graded.score,
        correct: graded.correct,
        total: QUESTION_KEY.length,
        timerSec: timerSec,
        answers: graded.letters,
        device: device,
        attempt: attempt,
      };
      sheet.appendRow([row.timestamp, row.session, safeCell_(row.nickname), row.score, row.correct, row.total, row.timerSec, row.answers, row.device, row.attempt]);
      rows.push(row);
      CacheService.getScriptCache().remove(cacheKey_(session, since));
    }
  } finally {
    lock.releaseLock();
  }

  const board = board_(rows, device);
  const mine = board.all.filter(function (r) { return r.you; })[0];
  return ok_({
    session: session,
    duplicate: duplicate,
    score: graded.score,
    correct: graded.correct,
    total: QUESTION_KEY.length,
    rank: mine ? mine.rank : null,
    players: board.all.length,
    leaderboard: board.top,
  });
}

function leaderboard_(body) {
  if (!sheetAvailable_()) return fail_('NO_LEADERBOARD', 'The shared leaderboard is not set up.');
  const session = normalizeSession_(body.session);
  if (!session) return fail_('BAD_SESSION', 'Session codes are 3–16 letters or numbers.');
  const device = token_(body.deviceId);
  const since = hubResetAt_('redeemers-challenge');

  const cache = CacheService.getScriptCache();
  let rows = null;
  const cached = cache.get(cacheKey_(session, since));
  if (cached) {
    try { rows = JSON.parse(cached); } catch (err) { rows = null; }
  }
  if (!rows) {
    rows = readRows_(sheet_()).filter(function (r) { return r.session === session && r.time > since; });
    const compact = rows.map(function (r) {
      return { nickname: r.nickname, score: r.score, correct: r.correct, device: r.device, time: r.time };
    });
    try { cache.put(cacheKey_(session, since), JSON.stringify(compact), CACHE_SECONDS); } catch (err) { /* too big to cache */ }
    rows = compact;
  }
  const board = board_(rows, device);
  return ok_({ session: session, total: QUESTION_KEY.length, players: board.all.length, leaderboard: board.top });
}

// ───────────── Scoring (server is the source of truth for shared scores) ─────────────

/** Returns { score, correct, letters } or null if the answers are malformed. */
function grade_(answers, timerSec) {
  if (!Array.isArray(answers) || answers.length !== QUESTION_KEY.length) return null;
  const byId = {};
  for (let i = 0; i < answers.length; i++) {
    const a = answers[i];
    if (!a || typeof a !== 'object') return null;
    const id = String(a.id);
    if (Object.prototype.hasOwnProperty.call(byId, id)) return null;
    byId[id] = a;
  }
  let score = 0;
  let correct = 0;
  const letters = [];
  for (let q = 0; q < QUESTION_KEY.length; q++) {
    const key = QUESTION_KEY[q];
    const a = byId[key.id];
    if (!a) return null;
    const choice = Number(a.choice);
    if (!Number.isInteger(choice) || choice < -1 || choice >= key.choices) return null;
    letters.push(choice < 0 ? '-' : 'ABCD'.charAt(choice));
    if (choice === key.answer) {
      correct += 1;
      score += POINTS_PER_CORRECT + speedBonus_(a.ms, timerSec);
    }
  }
  return { score: score, correct: correct, letters: letters.join('') };
}

function speedBonus_(elapsedMs, timerSec) {
  if (!timerSec) return 0;
  const ms = Number(elapsedMs);
  if (!isFinite(ms) || ms < MIN_HUMAN_MS) return 0;
  const total = timerSec * 1000;
  if (ms >= total) return 0;
  return Math.round((MAX_SPEED_BONUS * (total - ms)) / total);
}

/** Best score per device + nickname, ranked 1, 2, 2, 4… Device ids never leave the server. */
function board_(rows, device) {
  const best = {};
  rows.forEach(function (r) {
    const key = r.device + '|' + String(r.nickname).toLowerCase();
    const prev = best[key];
    const time = r.time != null ? r.time : r.timestamp instanceof Date ? r.timestamp.getTime() : 0;
    if (!prev || r.score > prev.score || (r.score === prev.score && time < prev.time)) {
      best[key] = { nickname: r.nickname, score: r.score, correct: r.correct, time: time, you: !!device && r.device === device };
    }
  });
  const list = Object.keys(best)
    .map(function (k) { return best[k]; })
    .sort(function (a, b) { return b.score - a.score || b.correct - a.correct || a.time - b.time; });
  let rank = 0;
  const all = list.map(function (r, i) {
    if (i === 0 || r.score !== list[i - 1].score) rank = i + 1;
    return { rank: rank, nickname: r.nickname, score: r.score, correct: r.correct, you: r.you };
  });
  return { all: all, top: all.slice(0, LEADERBOARD_SIZE) };
}

// ───────────── Sheet access ─────────────

function sheetAvailable_() {
  if (!LEADERBOARD_ENABLED) return false;
  try {
    return !!SpreadsheetApp.getActiveSpreadsheet();
  } catch (err) {
    return false;
  }
}

function sheet_() {
  if (!sheetAvailable_()) return null;
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sheet = ss.getSheetByName(SHEET_NAME);
  if (!sheet) {
    sheet = ss.insertSheet(SHEET_NAME);
    sheet.appendRow(HEADERS);
    sheet.setFrozenRows(1);
  }
  return sheet;
}

function readRows_(sheet) {
  const values = sheet.getDataRange().getValues();
  const rows = [];
  for (let i = 1; i < values.length; i++) {
    const v = values[i];
    if (!v[1]) continue;
    const ts = v[0] instanceof Date ? v[0] : new Date(v[0]);
    rows.push({
      timestamp: ts,
      time: ts.getTime() || 0,
      session: String(v[1]),
      nickname: String(v[2]),
      score: Number(v[3]) || 0,
      correct: Number(v[4]) || 0,
      device: String(v[8]),
      attempt: String(v[9]),
    });
  }
  return rows;
}

// ───────────── Validation helpers ─────────────

function normalizeSession_(raw) {
  const code = String(raw == null ? '' : raw).toUpperCase().replace(/[^A-Z0-9-]/g, '').slice(0, 16);
  return code.length >= 3 ? code : '';
}

function cleanName_(raw) {
  if (typeof raw !== 'string') return '';
  const tidy = raw
    .normalize('NFC')
    .replace(/[\u0000-\u001F\u007F-\u009F<>]/g, '')
    .replace(/\s+/g, ' ')
    .trim();
  return Array.from(tidy).slice(0, NAME_MAX).join('').trim();
}

function token_(raw) {
  return typeof raw === 'string' && /^[A-Za-z0-9-]{16,64}$/.test(raw) ? raw : '';
}

/** Stops a nickname such as "=HYPERLINK(...)" from being treated as a formula. */
function safeCell_(text) {
  return /^[=+\-@]/.test(text) ? "'" + text : text;
}

function serviceUrl_() {
  try {
    return ScriptApp.getService().getUrl() || '';
  } catch (err) {
    return '';
  }
}

function cacheKey_(session, since) {
  return 'board:' + session + ':' + (since || 0);
}

function ok_(data) {
  const out = { ok: true, serverTime: Date.now() };
  Object.keys(data).forEach(function (k) { out[k] = data[k]; });
  return out;
}

function fail_(code, message) {
  return { ok: false, error: code, message: message };
}

function json_(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);
}
