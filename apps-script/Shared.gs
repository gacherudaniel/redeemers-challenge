  return {
    N,
    E,
    S,
    W,
    DIRS,
    DELTA,
    SHAPES,
    TIEBREAK_LEVEL,
    rotate,
    covers,
    sizeForLevel,
    features,
    generateLevel,
    maskAt,
    connected,
    isSolved,
    route,
    minRotations,
    tap,
    hint,
    levelScore,
    scoreRun,
    tiebreakSettings,
    checkTiebreak,
  };
});


