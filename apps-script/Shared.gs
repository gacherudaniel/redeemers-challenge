      if (!L || L.level !== i + 1) return { ok: false, reason: 'Levels out of order.' };
      if (![L.ms, L.rotations, L.hints].every((v) => Number.isInteger(v) && v >= 0)) return { ok: false, reason: 'Invalid level data.' };
      const lvl = generateLevel(seed, L.level, s);
